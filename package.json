{
  "name": "systrol-monorepo",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:generate": "pnpm --filter @systrol/database generate",
    "db:migrate": "pnpm --filter @systrol/database migrate:deploy",
    "db:seed": "pnpm --filter @systrol/database seed",
    "media:migrate": "tsx scripts/migrate-media.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.50.1",
    "@typescript-eslint/eslint-plugin": "8.23.0",
    "@typescript-eslint/parser": "8.23.0",
    "eslint": "9.20.0",
    "husky": "9.1.7",
    "lint-staged": "15.4.3",
    "prettier": "3.5.1",
    "turbo": "2.3.3",
    "typescript": "5.7.2"
  }
}
